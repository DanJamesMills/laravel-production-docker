server {
    listen 80;
    listen [::]:80;
    server_name example.com;
    root /var/www/html/public;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Configure Content-Security-Policy for your app's requirements:
    # add_header Content-Security-Policy "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'" always;

    server_tokens off;

    index index.php;
    charset utf-8;

    # Match your PHP upload limits (upload_max_filesize / post_max_size in php.ini)
    client_max_body_size 100M;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    # Vite content-hashes all asset filenames on every build, so 1y immutable is safe
    location ~* \.(jpg|jpeg|png|gif|ico|svg|webp|woff|woff2|ttf|eot|css|js)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Only index.php may execute PHP
    location ~ ^/index\.php(/|$) {
        fastcgi_pass php:9000;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_hide_header X-Powered-By;
        include fastcgi_params;

        # Larger buffers for Inertia.js — page props are JSON payloads that can be large
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }

    # Block all other PHP files
    location ~ \.php$ {
        return 404;
    }

    # Block hidden files (except .well-known for SSL certificate validation)
    location ~ /\.(?!well-known).* {
        deny all;
    }

    # -------------------------------------------------------------------------
    # Laravel Reverb — WebSockets for real-time features (Inertia broadcasting)
    # Uncomment if you have added the Reverb service to docker-compose.yml
    # -------------------------------------------------------------------------
    # location /app {
    #     proxy_pass http://reverb:8080;
    #     proxy_http_version 1.1;
    #     proxy_set_header Upgrade $http_upgrade;
    #     proxy_set_header Connection "Upgrade";
    #     proxy_set_header Host $host;
    #     proxy_cache_bypass $http_upgrade;
    #     proxy_read_timeout 60s;
    # }

    # -------------------------------------------------------------------------
    # Inertia SSR — uncomment if running the Node.js SSR server (port 13714)
    # Start it with: php artisan inertia:start-ssr
    # -------------------------------------------------------------------------
    # location = /ssr {
    #     proxy_pass http://127.0.0.1:13714;
    #     proxy_http_version 1.1;
    #     proxy_set_header Host $host;
    # }
}
